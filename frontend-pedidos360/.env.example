# Copiar como ".env.local" (no se sube a GitHub) y completar.
# Vite solo expone al navegador las variables que empiezan con VITE_.
# Ninguna es secreta: client id y tenant id son identificadores públicos.

# "practica" = sin Azure: eliges rol en la pantalla de login (backend con SECURITY_ENABLED=false)
# "entra"    = login real con Microsoft Entra ID (MSAL)
VITE_AUTH_MODE=practica

# Registro "pedidos360-spa" en Entra (Overview)
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# Scope expuesto por el registro "pedidos360-api" (Expose an API)
VITE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Vacío en local (usa el proxy de Vite hacia los microservicios).
# En AWS: la URL de API Gateway, p. ej. https://abc123.execute-api.us-east-1.amazonaws.com
VITE_API_BASE_URL=
