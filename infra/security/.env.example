# Configuración de Microsoft Entra ID para los microservicios (Etapa 6).
# Copiar como ".env" y completar con los valores de docs/etapa5-entra-id.md.
# Mientras SECURITY_ENABLED=false, los endpoints quedan abiertos (modo práctica).

SECURITY_ENABLED=false

# Overview del registro "pedidos360-api" en Entra:
#   Directory (tenant) ID
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
#   Application (client) ID de la API (NO el de la SPA)
ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
