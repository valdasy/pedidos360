# Copiar como ".env" y completar. NO se sube a GitHub.

# ---------- RabbitMQ (EC2 "mq": IP PRIVADA, misma VPC) ----------
RABBITMQ_HOST=10.0.0.10
RABBITMQ_USER=pedidos360
RABBITMQ_PASS=cambiar

# ---------- Mailpit (corre junto a RabbitMQ en la EC2 "mq") ----------
SMTP_HOST=10.0.0.10
SMTP_PORT=1025

# ---------- Oracle: endpoint de Amazon RDS ----------
DB_HOST=pedidos360-db.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=1521
# En RDS el "service name" es el DB name que elegiste al crearla (p. ej. ORCL)
DB_SERVICE=ORCL
ORDERS_DB_PASSWORD=cambiar
CATALOG_DB_PASSWORD=cambiar

# ---------- Seguridad (Microsoft Entra ID) ----------
SECURITY_ENABLED=true
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000

# ---------- Prueba local con Docker Desktop ----------
# host.docker.internal = tu PC visto desde dentro de un contenedor
# RABBITMQ_HOST=host.docker.internal
# SMTP_HOST=host.docker.internal
# DB_HOST=host.docker.internal
# DB_PORT=1522
# DB_SERVICE=FREEPDB1
# SECURITY_ENABLED=false
