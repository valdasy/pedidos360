# Copiar como ".env". NO se sube a GitHub.

# Dirección que los brokers anuncian a los microservicios:
#   local (microservicios con mvnw en tu PC): localhost
#   AWS: IP PRIVADA de la EC2 kafka (la usa la EC2 apps)
KAFKA_ADVERTISED_HOST=localhost

# Kafka UI (http://localhost:8090)
KAFKA_UI_USER=admin
KAFKA_UI_PASS=cambiarKafkaUi123
# Local: 127.0.0.1 (solo tu PC). AWS: 0.0.0.0 (el Security Group la limita a tu IP)
KAFKA_UI_BIND=127.0.0.1

# Lista de brokers para los microservicios que corren en tu PC (los lee spring.config.import)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093
